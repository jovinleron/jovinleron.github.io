<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jovin Leron – Photojournalism</title>
<style>
:root{--bg:#e8ebee;--ink:#14181c;--mute:#5b6670;--card:#fff;--line:#c9d0d6;--accent:#1f3a5f}
@media (prefers-color-scheme:dark){:root{--bg:#12161a;--ink:#eef1f3;--mute:#9aa6b0;--card:#1b2127;--line:#2c353d;--accent:#8fb4e3}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
header{max-width:1100px;margin:0 auto;padding:56px 20px 24px}
h1{font:700 clamp(2.4rem,7vw,4.6rem)/1 Georgia,"Times New Roman",serif;margin:0 0 12px;letter-spacing:-.02em}
header p{max-width:52ch;margin:0;color:var(--mute)}
.tools{max-width:1100px;margin:0 auto;padding:12px 20px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.tools button,.tools input{font:inherit;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:7px 14px;border-radius:999px;cursor:pointer}
.tools button[aria-pressed=true]{background:var(--accent);border-color:var(--accent);color:#fff}
.tools input{cursor:text;flex:1;min-width:160px;border-radius:8px}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
main{max-width:1100px;margin:0 auto;padding:8px 20px 64px;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}
a.card{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);color:inherit;text-decoration:none}
a.card:hover h2{text-decoration:underline}
.ph{aspect-ratio:3/2;background:var(--line);display:grid;place-items:center;color:var(--mute);font-size:.85rem;overflow:hidden}
.ph img{width:100%;height:100%;object-fit:cover;display:block}
.txt{padding:12px 14px 16px}
h2{font:600 1.05rem/1.3 Georgia,serif;margin:0 0 6px}
.meta{margin:0;color:var(--mute);font-size:.85rem}
#empty{display:none;max-width:1100px;margin:0 auto;padding:0 20px;color:var(--mute)}
footer{max-width:1100px;margin:0 auto;padding:0 20px 48px;color:var(--mute);font-size:.85rem}
</style>
</head>
<body>
<header>
  <h1>Jovin Leron</h1>
  <p>Photojournalist for Budyong Online. Every photo links to the published post on Facebook.</p>
</header>

<div class="tools" id="tools" role="group" aria-label="Filter stories">
  <input id="q" type="search" placeholder="Search headlines" aria-label="Search headlines">
</div>
<main id="grid"></main>
<p id="empty">No stories match. Try another word or category.</p>
<footer>Photos © Jovin Leron. Stories © Budyong Online.</footer>

<script>
/* HOW TO EDIT:
   For each story, fill in title, date (e.g. "Mar 2026"), and cat (category).
   Put the photo in the images/ folder and name it as in "img" (default images/01.jpg).
   Stories with no image show a grey box until you add one. */
var B="https://www.facebook.com/share/";
var S=[
[1,"p/1MyYHCAQo8/"],[2,"p/1FhHgo7qGX/"],[3,"p/1QTNuUttqE/"],
[5,"p/14zwiDmJzBQ/"],[6,"p/19pw1wGhvp/"],[7,"p/16RuV6JsKMq/"],[8,"p/1A8KuQvBwy/"],
[9,"1dTno3cSXr/"], /* #9 has no /p/ — check this link */
[10,"p/19seveasFu/"],[11,"p/1JEnQJKz7W/"],[12,"p/19aEayCA49/"],[13,"p/1CSoGFS7Pb/"],
[14,"p/1EKa2HZJ8g/"],[15,"p/1EeMHprWLj/"],[17,"p/18Xhr7WtZN/"],[18,"p/18gzobwtbK/"],
[19,"p/17YkrSS3tV/"],[20,"p/1C5rEL5Zqf/"],[21,"p/1Jagggwiiy/"],[22,"p/1CouRuKrKL/"],
[23,"p/18j9gnd6c7/"],[24,"p/198xv7EvR9/"],[25,"p/1RZNUa1jJj/"],[26,"p/1BkBwzYjf3/"],
[27,"p/1BKSr54Anm/"],[28,"p/18jMV2drrE/"],[29,"p/19Lw9dTG9c/"],[30,"p/1Duz3vdLHB/"],
[31,"p/197bvppLSc/"],[32,"p/1DsTHwWfEM/"],[33,"p/1DD8GEQbaK/"],[34,"p/1Lu2DcTw9y/"],
[35,"p/1HwiA9ymJp/"],[36,"p/19R6eevehK/"],[37,"p/1GpSykbdwt/"],[38,"p/19MTHkgLj6/"],
[39,"p/1GiBAiSLcp/"],[40,"p/1J61fQadLB/"],[41,"p/1AAz5bsrfD/"],[42,"p/19rJvrnxBJ/"],
[43,"p/19wLiDPKYG/"],[44,"p/1cfLjzQj3K/"],[45,"p/1JQAaDpMvm/"],[46,"p/1UvJ19vJ5V/"],
[47,"p/1KJocLwQ6f/"],[48,"p/18B8YNUCAp/"],[49,"p/1DpjEaq1j5/"],[50,"p/1E6ffnsJaW/"],
[51,"p/1AX4XEY9db/"],[52,"p/1F7whAp2AK/"],[53,"p/1Dhx6UGVQz/"],[54,"p/1Fxw4HHQZ6/"],
[55,"p/1CaNwvAU97/"],[56,"p/1CNQfvScy1/"]
].map(function(r){
  var id=("0"+r[0]).slice(-2);
  return {title:"Story "+id+" (add headline)",date:"",cat:"Uncategorized",img:"images/"+id+".jpg",url:B+r[1]};
});

var grid=document.getElementById("grid"),tools=document.getElementById("tools"),
    q=document.getElementById("q"),empty=document.getElementById("empty"),cat="All";

var cats=["All"];
S.forEach(function(s){if(cats.indexOf(s.cat)<0)cats.push(s.cat)});
if(cats.length>2){
  cats.forEach(function(c){
    var b=document.createElement("button");
    b.textContent=c;b.setAttribute("aria-pressed",c==="All");
    b.onclick=function(){cat=c;[].forEach.call(tools.querySelectorAll("button"),function(x){x.setAttribute("aria-pressed",x===b)});render()};
    tools.insertBefore(b,q);
  });
}

function render(){
  var t=q.value.toLowerCase(),n=0;
  grid.innerHTML="";
  S.forEach(function(s){
    if((cat!=="All"&&s.cat!==cat)||(t&&s.title.toLowerCase().indexOf(t)<0))return;
    n++;
    var a=document.createElement("a");a.className="card";a.href=s.url;a.target="_blank";a.rel="noopener";
    var ph=document.createElement("div");ph.className="ph";
    var im=new Image();im.alt=s.title;im.loading="lazy";im.src=s.img;
    im.onload=function(){ph.textContent="";ph.appendChild(im)};
    ph.textContent="Photo coming soon";
    var tx=document.createElement("div");tx.className="txt";
    var h=document.createElement("h2");h.textContent=s.title;
    var m=document.createElement("p");m.className="meta";
    m.textContent=[s.date,s.cat!=="Uncategorized"?s.cat:""].filter(Boolean).join(" | ")||"Published on Facebook";
    tx.appendChild(h);tx.appendChild(m);a.appendChild(ph);a.appendChild(tx);grid.appendChild(a);
  });
  empty.style.display=n?"none":"block";
}
q.oninput=render;render();
</script>
</body>
</html>
